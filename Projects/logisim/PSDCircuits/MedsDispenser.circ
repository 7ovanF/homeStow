      <a name="facing" val="south"/>
      <a name="inputs" val="4"/>
    </comp>
    <comp lib="1" loc="(700,620)" name="AND Gate">
      <a name="size" val="30"/>
    </comp>
    <comp lib="1" loc="(730,540)" name="Controlled Buffer"/>
    <comp lib="2" loc="(200,80)" name="Decoder">
      <a name="facing" val="south"/>
      <a name="select" val="2"/>
    </comp>
    <comp lib="8" loc="(1075,547)" name="Text">
      <a name="text" val="output wont show if the bit aint selected"/>
    </comp>
    <comp lib="8" loc="(1129,586)" name="Text">
      <a name="text" val="in logisim's builtin ram, read only enables the changing of the output"/>
    </comp>
    <comp lib="8" loc="(1186,647)" name="Text">
      <a name="text" val="but it seems, in real cases, READ = 0 will make output Hi-Z. so fuck it"/>
    </comp>
    <comp lib="8" loc="(1256,500)" name="Text">
      <a name="text" val="READ can be either clocked or free (diff of Sync SRAM vs Async SRAM). in this case i just use Async, but if used, just use a D or SR Flip-flop"/>
    </comp>
    <comp lib="8" loc="(1454,616)" name="Text">
      <a name="text" val="so for example if output was (data before) , it will be (data right now) if read is on but if its off, after switching to the next address, the output wont change"/>
    </comp>
    <comp lib="8" loc="(188,43)" name="Text">
      <a name="text" val="decoder can use chip select as en"/>
    </comp>
    <comp lib="8" loc="(385,793)" name="Text">
      <a name="text" val="A bit slice represents bit-n of ALL addresses!"/>
    </comp>
    <comp lib="8" loc="(388,886)" name="Text">
      <a name="text" val="a 4x16 RAM chip uses 16 4 bit slices."/>
    </comp>
    <comp lib="8" loc="(399,849)" name="Text">
      <a name="text" val="first one to represent bit 0, second represents bit 1, and so on."/>
    </comp>
    <comp lib="8" loc="(402,965)" name="Text">
      <a name="text" val="TLDR example: bit slice contains 4 bits -&gt; there are 4 addresses"/>
    </comp>
    <comp lib="8" loc="(404,821)" name="Text">
      <a name="text" val="so for example, 4 bit slices can be used for 4 addresses (can be more)"/>
    </comp>
    <comp lib="8" loc="(406,1015)" name="Text">
      <a name="text" val="+ that means this is always on, one of these is selected (but why do we need to select which bits)"/>
    </comp>
    <comp lib="8" loc="(985,461)" name="Text">
      <a name="text" val="to join the several outputs, an OR is needed (no output is U yet)"/>
    </comp>
    <comp loc="(610,110)" name="RAMCell"/>
    <comp loc="(610,210)" name="RAMCell"/>
    <comp loc="(610,310)" name="RAMCell"/>
    <comp loc="(610,410)" name="RAMCell"/>
