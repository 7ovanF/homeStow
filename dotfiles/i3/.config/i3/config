# === Variables ===

set $mod Mod4
set $term alacritty

set $wallpaper ${HOME}/Pictures/Wallpapers/chitty-chitty_bang-bang.webp
set $i3-config-home ${XDG_CONFIG_HOME:-$HOME/.config}/i3
set $i3-scripts-home $i3-config-home/scripts

# Home row direction keys, like vim

set $left h
set $down j
set $up k
set $right l

# === Visual Theme ===

gaps inner 0
gaps outer 0

font pango:Liberation Mono 9
default_border pixel 2

# set $cl_high #2ecbd1
# set $cl_indi #2ecbd1
# set $cl_back #1b1f22
# set $cl_fore #d6dde2
# set $cl_urge #ff6b7a

# i3 color order:
# <border> <background> <text> <indicator> <child_border>
#
# client.focused $cl_high $cl_high $cl_fore $cl_indi $cl_high
# client.focused_inactive $cl_back $cl_back $cl_fore $cl_back $cl_back
# client.unfocused $cl_back $cl_back $cl_fore $cl_back $cl_back
# client.urgent $cl_urge $cl_urge $cl_fore $cl_urge $cl_urge

# === Display ===
# i3 runs under X11, so output configuration is normally handled
# by xrandr/Xorg rather than i3.
# Equivalent to:
# output eDP-1 resolution 1920x1080
# output eDP-1 scale 1.1
# Put your xrandr command in ~/.xprofile, ~/.xinitrc,
# or your display manager's startup configuration.
# Example:
exec --no-startup-id xrandr --output eDP-1 --mode 1920x1080 --scale 1.1x1.1
# Wallpaper is also normally handled by feh/nitrogen/etc.

exec --no-startup-id feh --bg-fill "$wallpaper"
# === Input ===
# i3 itself does not configure input devices like Sway.
# Configure these through Xorg/xinput.
# Keyboard layout:
# setxkbmap pl
# Example startup command:

exec --no-startup-id setxkbmap pl

# Use pactl to adjust volume in PulseAudio.
set $refresh_i3status killall -SIGUSR1 i3status
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +10% && $refresh_i3status
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -10% && $refresh_i3status
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && $refresh_i3status
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && $refresh_i3status


# Touchpad/mouse settings should be configured with xinput or
# an Xorg configuration file.
# === i3 Bindings ===
# Open Terminal

bindsym $mod+Return exec --no-startup-id $term
bindsym Ctrl+Mod1+t exec --no-startup-id $term

# Kill Window

bindsym $mod+q kill
bindsym Mod1+F4 kill

# Reload config

bindsym $mod+Shift+c reload

# Exit i3

bindsym $mod+Shift+e exec --no-startup-id i3-nagbar -t warning -m 'End i3?' -b 'Yes, exit i3' 'i3-msg exit'

# === Workspace ===
# Window focus

bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right

bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move window

bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Workspace switching

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

# Move window cross-workspace

bindsym $mod+Shift+1 move container to workspace number 1; workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2; workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3; workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4; workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5; workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6; workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7; workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8; workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9; workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10; workspace number 10

# === Layouts ===

bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+f fullscreen toggle

# Split modules

bindsym $mod+z split vertical
bindsym $mod+x split horizontal

# === Floating ===

bindsym $mod+Shift+space floating toggle; resize set width 1000 px height 800 px
bindsym $mod+space focus mode_toggle

floating_modifier $mod

# === Scratchpad ===

bindsym $mod+s scratchpad show
bindsym $mod+Shift+s move scratchpad; scratchpad show

# === Resize Mode ===

set $resize_step 50 px

mode "resize" {
bindsym $left resize shrink width $resize_step
bindsym $down resize grow height $resize_step
bindsym $up resize shrink height $resize_step
bindsym $right resize grow width $resize_step

    bindsym Left resize shrink width $resize_step
    bindsym Down resize grow height $resize_step
    bindsym Up resize shrink height $resize_step
    bindsym Right resize grow width $resize_step

    bindsym u move left $resize_step
    bindsym i move down $resize_step
    bindsym o move up $resize_step
    bindsym p move right $resize_step

    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}

bindsym $mod+r mode "resize"

# === Custom Programs ===
# Wiremix
# Sway:
# [app_id="wiremix"]
# i3/X11:
# [class="Wiremix"]
# The exact class can be checked with:
# xprop | grep WM_CLASS

for_window [class="Wiremix"] floating enable
for_window [class="Wiremix"] resize set 800 500
for_window [class="Wiremix"] move position center

# === Notifications ===
# swaync is Wayland-specific.
# If you have dunst installed:

exec --no-startup-id dunst

# Toggle dunst history/notifications depends on your dunst setup.
# Replace this with your preferred notification command.
bindsym $mod+n exec --no-startup-id ...
# === Rofi ===

# bindsym $mod+Tab exec --no-startup-id rofi -show drun
bindsym $mod+Tab exec --no-startup-id xfce4-appfinder

# Convenient for kali, bc categories are still there!
for_window [class="Xfce4-appfinder"] floating enable
for_window [class="Xfce4-appfinder"] resize set 800 500
for_window [class="Xfce4-appfinder"] move position center

# === Clipse ===
# clipse can still be used under X11, assuming its terminal UI
# and dependencies work in your environment.

exec --no-startup-id clipse -listen

# X11 window matching uses class instead of Wayland app_id.
# Because kitty's --class controls the X11 WM_CLASS value,
# this should match the terminal launched below.

for_window [class="clipse"] floating enable
for_window [class="clipse"] resize set 800 500
for_window [class="clipse"] move position center

bindsym $mod+v exec --no-startup-id $term --class clipse -e clipse

# === Blueman Manager ===

for_window [class="blueman-manager"] floating enable
for_window [class="blueman-manager"] resize set 900 700
for_window [class="blueman-manager"] move position center

# === Inactive Windows Transparency ===
# Sway script is not directly usable under X11.
# If you want this behavior under i3, use a compositor such as picom
# or an X11-specific script.
exec --no-startup-id $i3-scripts-home/inactive-windows-transparency.py
# === Startup ===
# Optional: start a compositor
exec --no-startup-id picom
# === Include additional i3 configuration ===
# Debian/Ubuntu:
include /etc/i3/config.d/*
# Arch/Linux distributions may instead use:
include /etc/i3/config.d/*
# User configuration:
include $i3-config-home/config.d/*

bar {
    status_command i3status
}
