{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "display": {
        "brightColor": false
    },
    "logo": {
    	"source": "$HOME/.config/fastfetch/ascii.txt",
        "color": { "1": "bright_cyan"},
    	"padding": {
    		"top": 2,
    		"left": 0,
            "right": 4
    	}
    },
    "modules": [
        {
            "type": "title",
            "format": "{user-name-colored} @ {host-name-colored}",
            "color": {
                "user": "blue",
                "host": "bright_cyan"
            }
        },
        {
            "type": "custom",
            "format": "\u001b[90m┌──────────────── MACHINE ─────────────────┐"
        },
        {
            "type": "host",
            "key": "{icon} PC",
            "keyColor": "bright_cyan"
        },
        {
            "type": "cpu",
            "key": "  ├",
            "keyColor": "cyan",
            "format": "{name}"
        },
       {
            "type": "memory",
            "key": "  ├󰍛",
            "keyColor": "cyan"
        },
        {
            "type": "disk",
            "key": "  └",
            "keyColor": "cyan"
        },
        {
            "type": "os",
            "key": "{icon} OS",
            "keyColor": "yellow"
        },
        {
            "type": "kernel",
            "key": "  ├",
            "keyColor": "yellow"
        },
        {
            "type": "shell",
            "key": "  └",
            "keyColor": "yellow"
        },
        {
            "type": "wm",
            "key": "󰟪 WM",
            "keyColor": "blue"
        },
        {
            "type": "terminal",
            "key": "  └",
            "keyColor": "blue"
        },
        {
            "type": "custom",
            "format": "\u001b[90m└──────────────────────────────────────────┘"
        },
        {
            "type": "custom",
            "format": "\u001b[90m┌───────────────── STATUS ─────────────────┐"
        },
        {
            "type": "command",
            "key": "  OS Age ",
            "keyColor": "red",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "uptime",
            "key": "  Uptime ",
            "keyColor": "red"
        },
        {
            "type": "battery",
            "key": "  Battery ",
            "keyColor": "red"
        },
        {
            "type": "custom",
            "format": "\u001b[90m└──────────────────────────────────────────┘"
        },
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        }
 
    ]
}
