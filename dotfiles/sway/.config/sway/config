# Basic Settings
set $mod Mod4
set $term kitty
# Wallpaper
set $wallpaper '~/Pictures/Wallpapers/sebastian-svenson-unsplash.jpg'

# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l

# === Visual Theme ===
gaps inner 8

font pango:Liberation Mono 9

default_border pixel 1

set $cl_high #2ecbd1
set $cl_indi #2ecbd1
set $cl_back #1b1f22
set $cl_fore #d6dde2
set $cl_urge #ff6b7a

client.focused          $cl_high $cl_high $cl_fore $cl_indi $cl_high
client.focused_inactive $cl_back $cl_back $cl_fore $cl_back $cl_back
client.unfocused        $cl_back $cl_back $cl_fore $cl_back $cl_back
client.urgent           $cl_urge $cl_urge $cl_fore $cl_urge $cl_urge

# === Display ===
output eDP-1 resolution 1920x1080
output eDP-1 scale 1.1

output * background $wallpaper fill

# exec 'sleep 3; swaymsg workspace 1'

# === Input ===
# Keyboard
input type:keyboard {
    xkb_layout pl
    repeat_delay 280
    repeat_rate 40
}
# Touchpad & Scroll
input type:touchpad {
    pointer_accel 0.42
    accel_profile adaptive
    tap enabled
    tap_button_map lrm
    natural_scroll enabled
    dwt enabled # you dont need this for touchpads
    drag_lock disabled
}
# Mouse
input type:pointer {
    pointer_accel -0.22
    accel_profile adaptive
    natural_scroll disabled
    dwt disabled
    drag_lock disabled
}

# === Sway Bindings ===
# Open Terminal 
bindsym $mod+Return exec $term
bindsym Ctrl+Alt+t exec $term
# Kill Window
bindsym $mod+q kill
bindsym Alt+f4 kill
# reload configs
bindsym $mod+Shift+c reload
# swaymsg close
bindsym $mod+Shift+e exec swaynag -t warning -m 'End sway?' -b 'Yes, exit sway' 'swaymsg exit'

# Focus
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right

bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right


bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right


bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

bindsym $mod+Shift+1 move container to workspace number 1; workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2; workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3; workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4; workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5; workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6; workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7; workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8; workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9; workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10; workspace number 10

bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+m fullscreen

bindsym $mod+Shift+space floating toggle; resize set width 1000 height 800;
bindsym $mod+space focus mode_toggle


# Scratchpad
bindsym $mod+s scratchpad show
bindsym $mod+Shift+s move scratchpad; scratchpad show

mode "resize" {
    bindsym $left resize shrink width 25px
    bindsym $down resize grow height 25px
    bindsym $up resize shrink height 25px
    bindsym $right resize grow width 25px

    bindsym Left resize shrink width 25px
    bindsym Down resize grow height 25px
    bindsym Up resize shrink height 25px
    bindsym Right resize grow width 25px

    bindsym u move left 25px
    bindsym i move down 25px
    bindsym o move up 25px
    bindsym p move right 25px


    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"

# === Custom Programs ===
# Specifically for wiremix
for_window [app_id="wiremix"] floating enable
for_window [app_id="wiremix"] resize set width 800 height 500
for_window [app_id="wiremix"] move position center

# Notification center (swaync)
exec swaync
bindsym $mod+n exec swaync-client -t -sw

# rofi
bindsym $mod+Tab exec rofi -show drun
# clipse (clipboard)
exec clipse -listen
for_window [app_id="clipse"] floating enable
for_window [app_id="clipse"] resize set width 800 height 500
for_window [app_id="clipse"] move position center
bindsym $mod+v exec $term --class clipse -e clipse                               # bind floating shell with clipse TUI

# i think mako doesnt need a start... lmao

# Include other default sawy modules
include /etc/sway/config.d/*
include '$(/usr/libexec/sway/layered-include "/usr/share/sway/config.d/*.conf" "/etc/sway/config.d/*.conf" "${XDG_CONFIG_HOME:-$HOME/.config}/sway/config.d/*.conf")'
