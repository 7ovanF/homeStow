# Basic Settings
set $mod Mod4
set $term kitty

# Wallpaper
set $wallpaper '~/Pictures/Wallpapers/sunset.jpg'

# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l

# === Visual Theme ===
gaps inner 6
gaps outer -1

font pango:Liberation Mono 9

seat seat0 xcursor_theme Hacked-Sky 24

default_border pixel 1

set $cl_high #2ecbd1
set $cl_indi #2ecbd1
set $cl_back #1b1f22
set $cl_fore #d6dde2
set $cl_urge #ff6b7a

client.focused          $cl_high $cl_high $cl_fore $cl_indi $cl_high
client.focused_inactive $cl_back $cl_back $cl_fore $cl_back $cl_back
client.unfocused        $cl_back $cl_back $cl_fore $cl_back $cl_back
client.urgent           $cl_urge $cl_urge $cl_fore $cl_urge $cl_urge

# === Display ===
output eDP-1 resolution 1920x1080
output eDP-1 scale 1.1
# output eDP-1 transform 270

output * background $wallpaper stretch

# exec 'sleep 3; swaymsg workspace 1'

# === Input ===
# Keyboard
input type:keyboard {
    xkb_layout pl
    repeat_delay 280
    repeat_rate 40
}
# Touchpad & Scroll
input type:touchpad {
    pointer_accel 0.42
    accel_profile adaptive
    tap enabled
    tap_button_map lrm
    natural_scroll enabled
    dwt enabled # you dont need this for touchpads
    drag_lock disabled
}
# Mouse
input type:pointer {
    pointer_accel -0.55
    accel_profile adaptive
    natural_scroll disabled
    dwt disabled
    drag_lock disabled
}

# === Sway Bindings ===
bindsym {
    # Open Terminal 
    $mod+Return exec $term
    Ctrl+Alt+t exec $term
    # Kill Window
    $mod+q kill
    Alt+f4 kill
    # reload configs
    $mod+Shift+c reload
    # swaymsg close
    $mod+Shift+e exec swaynag -t warning -m 'End sway?' -b 'Yes, exit sway' 'swaymsg exit'
}

# === Workspace ===
bindsym {
    # Window focus
    $mod+$left focus left
    $mod+$down focus down
    $mod+$up focus up
    $mod+$right focus right

    $mod+Left focus left
    $mod+Down focus down
    $mod+Up focus up
    $mod+Right focus right

    # Move window
    $mod+Shift+$left move left
    $mod+Shift+$down move down
    $mod+Shift+$up move up
    $mod+Shift+$right move right

    $mod+Shift+Left move left
    $mod+Shift+Down move down
    $mod+Shift+Up move up
    $mod+Shift+Right move right

    # Workspace switching
    $mod+1 workspace number 1
    $mod+2 workspace number 2
    $mod+3 workspace number 3
    $mod+4 workspace number 4
    $mod+5 workspace number 5
    $mod+6 workspace number 6
    $mod+7 workspace number 7
    $mod+8 workspace number 8
    $mod+9 workspace number 9
    $mod+0 workspace number 10

    # Move window cross-workspace
    $mod+Shift+1 move container to workspace number 1; workspace number 1
    $mod+Shift+2 move container to workspace number 2; workspace number 2
    $mod+Shift+3 move container to workspace number 3; workspace number 3
    $mod+Shift+4 move container to workspace number 4; workspace number 4
    $mod+Shift+5 move container to workspace number 5; workspace number 5
    $mod+Shift+6 move container to workspace number 6; workspace number 6
    $mod+Shift+7 move container to workspace number 7; workspace number 7
    $mod+Shift+8 move container to workspace number 8; workspace number 8
    $mod+Shift+9 move container to workspace number 9; workspace number 9
    $mod+Shift+0 move container to workspace number 10; workspace number 10

    # Layouts
    $mod+w layout tabbed
    $mod+e layout toggle split
    $mod+f fullscreen

    # Split modules
    $mod+z splitv
    $mod+x splith

    # Float
    $mod+Shift+space floating toggle; resize set width 1000 height 800;
    $mod+space focus mode_toggle

    # Scratchpad
    $mod+s scratchpad show
    $mod+Shift+s move scratchpad; scratchpad show
}

# Window dragging
floating_modifier $mod normal

# Resize mode
set $resize_step 50px
mode "resize" {
    bindsym {
        $left resize shrink width $resize_step
        $down resize grow height $resize_step
        $up resize shrink height $resize_step
        $right resize grow width $resize_step

        Left resize shrink width $resize_step
        Down resize grow height $resize_step
        Up resize shrink height $resize_step
        Right resize grow width $resize_step

        u move left $resize_step
        i move down $resize_step
        o move up $resize_step
        p move right $resize_step

        Return mode "default"
        Escape mode "default"
        $mod+r mode "default"
    }
}
bindsym $mod+r mode "resize"

# === Custom Programs ===
# Specifically for wiremix
for_window [app_id="wiremix"] floating enable
for_window [app_id="wiremix"] resize set width 800 height 500
for_window [app_id="wiremix"] move position center

# Notification center (swaync)
exec swaync
bindsym $mod+n exec swaync-client -t -sw

# rofi
bindsym $mod+Tab exec rofi -show drun

# clipse (clipboard)
exec clipse -listen
for_window [app_id="clipse"] floating enable
for_window [app_id="clipse"] resize set width 800 height 500
for_window [app_id="clipse"] move position center
bindsym $mod+v exec $term --class clipse -e clipse

# blueman-manager (make the window float)
for_window [app_id="blueman-manager"] floating enable
for_window [app_id="blueman-manager"] resize set width 900 height 700
for_window [app_id="blueman-manager"] move position center

# Include other default sawy modules
include /etc/sway/config.d/*
include '$(/usr/libexec/sway/layered-include "/usr/share/sway/config.d/*.conf" "/etc/sway/config.d/*.conf" "${XDG_CONFIG_HOME:-$HOME/.config}/sway/config.d/*.conf")'
